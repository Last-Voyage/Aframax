%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce96ceaa6fd0c8e48b319396a858c54f, type: 3}
  m_Name: IntroCutscene
  m_EditorClassIdentifier: 
  _dialogueData:
  - _displayedText: 'Captain: "I don''t like the looks of this. Did ya see that?
      Need you to check it out."'
    getTimeBeforeNextTextDisplays: 1
    _getTimeToDisplay: 4
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Captain: "Hey, you hear me down there?"'
    getTimeBeforeNextTextDisplays: 0.5
    _getTimeToDisplay: 1.5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Captain: \"Up all night again, 'ey? I thought I told you not
      to worry so much. You don't need to keep watch all night.\"\r"
    getTimeBeforeNextTextDisplays: 2.7
    _getTimeToDisplay: 5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Captain: \"You probably heard the rumors of people disappearin'
      'round here, but that was years ago; it ain't gonna happen now.\"\r\r"
    getTimeBeforeNextTextDisplays: 2
    _getTimeToDisplay: 4.4
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Captain: \"Anyway, listen, boat's stuck. Need you to fix that
      problem on our here rudder.\"\r\r"
    getTimeBeforeNextTextDisplays: 2
    _getTimeToDisplay: 2.5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Captain: \"That'd be the back of the boat, kid. In case you
      forgot.\"\r\r"
    getTimeBeforeNextTextDisplays: 1.5
    _getTimeToDisplay: 2
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Thomas: \"Yeah, yeah, grandma. I'll get your boat running...\"\r\r"
    getTimeBeforeNextTextDisplays: 0.5
    _getTimeToDisplay: 1.5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: "Captain: \"Well, I'll be... it really is just a vine. How the
      hell'd that get in there, anyway?\"\r\r\r"
    getTimeBeforeNextTextDisplays: 1.4
    _getTimeToDisplay: 5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Captain: "Nevermind, just shoot the damn thing down, will you?"'
    getTimeBeforeNextTextDisplays: 0.3
    _getTimeToDisplay: 1.5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: (harpoon fires)
    getTimeBeforeNextTextDisplays: 0.5
    _getTimeToDisplay: 1
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: (ship engine fails)
    getTimeBeforeNextTextDisplays: 5.5
    _getTimeToDisplay: 1
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Captain: "Better... but we still ain''t moving. Gonna need ya
      to head down below and check the generator. She don''t sound too great."'
    getTimeBeforeNextTextDisplays: 1.8
    _getTimeToDisplay: 6
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Thomas: "Come on, we''re this close..."'
    getTimeBeforeNextTextDisplays: 0.8
    _getTimeToDisplay: 1
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Captain: "Key''s on my door. Take it, and head down the hatch.
      There should be a helpful manual down there."'
    getTimeBeforeNextTextDisplays: 1
    _getTimeToDisplay: 5
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
  - _displayedText: 'Captain: "Easy fix, then we''re outta here."'
    getTimeBeforeNextTextDisplays: 1
    _getTimeToDisplay: 1
    _audioReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
