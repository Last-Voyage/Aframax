--- !u!1001 &1756502521
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2042843277735502377, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: m_Name
      value: Interactable Letter (2)
      objectReference: {fileID: 0}
    - target: {fileID: 2654585975503658956, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: _pageTexts.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2654585975503658956, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: _pageTexts.Array.data[0]
      value: No No No No NO!!
      objectReference: {fileID: 0}
    - target: {fileID: 2654585975503658956, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: _pageTexts.Array.data[1]
      value: 'What the hell happened, we just entered the swamp at the Devil''s Strait
        and everything went so wrong.


        I just finished my lookout shift
        when it happened, I had taken like 10 steps toward the break room when my
        replacement screamed and fell from the boat before I could turn.'
      objectReference: {fileID: 0}
    - target: {fileID: 2654585975503658956, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: _pageTexts.Array.data[2]
      value: 'One by one my compainions were pulled beneth the water screaming and
        fireing their guns.


'
      objectReference: {fileID: 0}
    - target: {fileID: 2654585975503658956, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: _pageTexts.Array.data[3]
      value: 'I managed to duck inside the boat, along with the "professor" and now
        we are here.


        It doesn''t make any sense, this is not the boat we
        arrived on!'
      objectReference: {fileID: 0}
    - target: {fileID: 9066643239372199602, guid: 167daec4c2dd3a14bb403baa5190c050,
        type: 3}
      propertyPath: m_LocalPosition.x
      value: 224.1058
      objectReference: {fileID: 0}
