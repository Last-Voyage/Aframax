      propertyPath: m_Enabled
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8156723921897994598, guid: 7e317323c18304343a6f00c37e7e4477,
        type: 3}
      propertyPath: _pageTexts.Array.data[0]
      value: "August Fourth, 1926\r\n\r\n7:23 am\r\n\nA supposedly deadly group of
        moonshiners in a  swamp, a completely MIA police force, and a small town
        just as full of rumors as it is of disease. \nThis isn't exactly what I had
        imagined, but it certainly beats all my previous assignments!  What a thrill!"
      objectReference: {fileID: 0}
    - target: {fileID: 8156723921897994598, guid: 7e317323c18304343a6f00c37e7e4477,
        type: 3}
      propertyPath: _pageTexts.Array.data[1]
      value: "They\u2019ve assigned to an old prohibition agent and his team.Hopefully
        my skills will prove useful for the team tomorrow.\n\t\n- Ruth Sencher, Forensic
        Anthropologist\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8156723921897994598, guid: 7e317323c18304343a6f00c37e7e4477,
        type: 3}
      propertyPath: _pageTexts.Array.data[2]
      value: "You recognize my handwriting, don\u2019t you?"
      objectReference: {fileID: 0}
